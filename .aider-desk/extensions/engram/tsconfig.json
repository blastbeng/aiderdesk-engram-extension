{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "typeRoots": [
      "/opt/npm/lib/node_modules/@aiderdesk/aiderdesk/node_modules/@types"
    ],
    "types": ["node"],
    "paths": {
      "@aiderdesk/extensions": [
        "/opt/npm/lib/node_modules/@aiderdesk/aiderdesk/node_modules/@aiderdesk/extensions/dist/index.d.ts"
      ],
      "zod": [
        "/opt/npm/lib/node_modules/@aiderdesk/aiderdesk/node_modules/zod/index.d.ts"
      ]
    }
  },
  "include": ["index.ts", "src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", "ConfigComponent.jsx"]
}
